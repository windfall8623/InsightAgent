# ==============================================================================
# InsightAgent Infrastructure Configuration (.env.infra.example)
#
# Copy this to .env when running with local Docker Compose infrastructure:
#   $ cp .env.infra.example .env
#   $ docker compose -f docker-compose.infra.yml up -d
# ==============================================================================

# Application Environment
INSIGHT_ENV=development
PORT=8000

# Redis Cache, Memory & Distributed Lock
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Engine
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your-api-key-if-auth-enabled

# OpenTelemetry / Jaeger Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=insight-agent

# Optional Neural BGE Embeddings / TEI Service
# INSIGHT_BGE_ENABLED=1
# INSIGHT_EMBEDDING_URL=http://localhost:8080/v1
