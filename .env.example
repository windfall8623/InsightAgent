# ═══════════════════════════════════════════════════════════════════════════
#  InsightAgent — 环境配置示例模板 (.env.example)
#  复制此文件为 .env 即可自定义您的模型与基础设施配置：
#    copy .env.example .env
# ═══════════════════════════════════════════════════════════════════════════


# ── 【模块一：核心推理大模型 (LLM Brain)】────────────────────────────────────
# 协议（OpenAI / Anthropic）自动智能探测。
INSIGHT_BASE_URL=https://openrouter.ai/api/v1
INSIGHT_MODEL=your-model-name
INSIGHT_API_KEY=your-api-key

# 生成控制参数
INSIGHT_PROVIDER=auto
INSIGHT_MAX_TOKENS=4096
INSIGHT_TEMPERATURE=0


# ── 【模块二：Jev 意图识别判别器 (Intent Classifier & Router)】──────────────
# 意图路由工作模式 (INSIGHT_INTENT_MODE): cascade / jev / rule
INSIGHT_INTENT_MODE=cascade

# Jev 判别服务接口配置（支持远程 API / 本地部署微服务）：
# 提示：若留空，系统自动启用内置的高保真 JevLocalSimulator
INSIGHT_JEV_URL=
INSIGHT_JEV_MODEL=typesafe-jev-v1
INSIGHT_JEV_API_KEY=


# ── 【模块三：智源 BAAI 两阶段 RAG (Embedding & Reranker)】───────────────────
# (1) 向量嵌入服务 (兼容 OpenAI / TEI / vLLM / Ollama 的 /v1/embeddings)
INSIGHT_EMBEDDING_URL=
INSIGHT_EMBEDDING_MODEL=BAAI/bge-m3
INSIGHT_EMBEDDING_API_KEY=

# (2) 语义精排重排服务 (兼容 TEI / Jina / BAAI / SiliconFlow /v1/rerank)
INSIGHT_RERANKER_URL=
INSIGHT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
INSIGHT_RERANKER_API_KEY=

# (3) 本地 FlagEmbedding 运行开关（若使用本地 Python 进程加载权重而非 HTTP 端点）：
INSIGHT_BGE_ENABLED=0
INSIGHT_DEVICE=cpu


# ── 【模块四：分布式中间件与存储 (Redis & Qdrant)】───────────────────────────
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=


# ── 【模块五：数仓体系与数据库路径配置】──────────────────────────────────────
# 数据源选择 (INSIGHT_DATASET): cn_retail (默认) / olist
INSIGHT_DATASET=cn_retail
# INSIGHT_CN_RETAIL_DB_PATH=
# INSIGHT_OLIST_DB_PATH=
